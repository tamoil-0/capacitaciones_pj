# ============================================
# ARCHIVOS PESADOS Y GENERADOS - NO SUBIR
# ============================================

# Node modules (Frontend)
node_modules/
frontend/node_modules/

# Vendor PHP (Backend)
vendor/
backend/vendor/

# Build outputs (temporales de PyInstaller)
build/
*.spec

# NOTA: dist/ con el .exe SÍ se sube a Git para que otras máquinas
# puedan usar el ejecutable sin necesidad de instalar Python

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Logs
*.log
storage/logs/*
!storage/logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (INCLUIDOS porque repo es privado)
# .env
# .env.local
# .env.*.local
# backend/.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Laravel específico
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/*
!backend/storage/app/.gitkeep
!backend/storage/app/public
backend/public/storage
backend/public/hot
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep

# Excel exports
backend/public/excel/*
!backend/public/excel/.gitkeep

# Backups SQL (solo estructura, no datos)
*.sql

# Vue/Vite
.vite/
frontend/.vite/
frontend/dist/

# Composer
composer.phar
composer.lock

# Package locks (opcional)
package-lock.json
yarn.lock

# Test files
test_*.php
prueba*.php
